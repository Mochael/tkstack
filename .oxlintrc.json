{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["typescript", "unicorn", "react"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "typescript/no-floating-promises": ["error", { "ignoreVoid": false }],
    "unicorn/no-null": "error"
  }
}
